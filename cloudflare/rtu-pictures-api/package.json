{
  "name": "rtu-pictures-api",
  "private": true,
  "description": "Cloudflare Worker for RTU audit photo auth and R2 uploads",
  "scripts": {
    "deploy": "node ./node_modules/wrangler/bin/wrangler.js deploy",
    "dry-run": "node ./node_modules/wrangler/bin/wrangler.js deploy --dry-run",
    "dev": "node ./node_modules/wrangler/bin/wrangler.js dev",
    "tail": "node ./node_modules/wrangler/bin/wrangler.js tail"
  },
  "devDependencies": {
    "wrangler": "^4.115.0"
  }
}
