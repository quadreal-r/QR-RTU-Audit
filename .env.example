# Android release signing
ANDROID_KEYSTORE_PATH=android/keystore/rtu-upload.keystore
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=rtu-upload
ANDROID_KEY_PASSWORD=

# Firebase App Distribution
# Create a Firebase project, add Android app com.quadreal.rtuqr, then paste the app id.
FIREBASE_APP_ID=
# Download a service-account JSON with Firebase App Distribution Admin and save as:
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
FIREBASE_GROUPS=testers

# iOS TestFlight (requires paid Apple Developer Program)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=AuthKey.p8
APPLE_TEAM_ID=
