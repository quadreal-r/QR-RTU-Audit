{
  "name": "qr-industrial-rtu-audit",
  "version": "1.1.48",
  "private": true,
  "description": "QuadReal RTU QR Audit tracker — web + Capacitor iOS/Android",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "sync": "npm run build:web && npm run sync:version && npx cap sync",
    "dev": "node scripts/dev.mjs",
    "dev:android": "node scripts/dev.mjs android",
    "dev:ios": "node scripts/dev.mjs ios",
    "ship:android": "npm run sync && node scripts/ship-android.mjs",
    "ship:ios": "npm run sync && node scripts/ship-ios.mjs",
    "ship:web": "npm run build:web && npx wrangler deploy",
    "ship:api": "npm --prefix cloudflare/rtu-pictures-api run deploy"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "browser-sync": "^3.0.4",
    "esbuild": "0.28.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.0.0"
  }
}
